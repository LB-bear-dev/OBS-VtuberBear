<?xml version="1.0" encoding="utf-8"?>
<Project>
    <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL'">
        <ClCompile>
            <ForcedIncludeFiles>$(MSBuildThisFileDirectory)ClangTidyShims.h;%(ClCompile.ForcedIncludeFiles)</ForcedIncludeFiles>
        </ClCompile>
    </ItemDefinitionGroup>
</Project>
