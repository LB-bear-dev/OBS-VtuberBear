            <OptimizeReferences>true</OptimizeReferences>
            <GenerateDebugInformation>true</GenerateDebugInformation>
            <DelayLoadDLLs>python3.dll</DelayLoadDLLs>
            <AdditionalLibraryDirectories>$(OBSPATH)\libobs\RelWithDebInfo;$(OBSPATH)\deps\w32-pthreads\RelWithDebInfo;$(DiscordBearDir)$(Configuration);$(QTPATH)\lib;$(PYTHONPATH)\libs</AdditionalLibraryDirectories>
            <AdditionalDependencies>DiscordBear.lib;obs.lib;w32-pthreads.lib;delayimp.lib;Qt6Core.lib;Qt6Gui.lib;Qt6Widgets.lib;kernel32.lib;user32.lib;gdi32.lib;winspool.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;comdlg32.lib;advapi32.lib</AdditionalDependencies>
            <!-- Control Flow Guard and EH continuation metadata for the psd_sdk code built with /guard:cf, and CET shadow stack support. -->
            <AdditionalOptions>/VERBOSE:LIB /GUARD:CF /GUARD:EHCONT /CETCOMPAT %(AdditionalOptions)</AdditionalOptions>
        </Link>
        <CustomBuildStep/>
    </ItemDefinitionGroup>
