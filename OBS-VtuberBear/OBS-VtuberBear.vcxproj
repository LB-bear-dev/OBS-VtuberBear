            <!-- The linker's /GUARD:CF and /GUARD:EHCONT need every module compiled with them. -->
            <ControlFlowGuard>Guard</ControlFlowGuard>
            <AdditionalOptions>/Zc:__cplusplus /guard:ehcont %(AdditionalOptions)</AdditionalOptions>
            <LanguageStandard_C>stdclatest</LanguageStandard_C>
            <PrecompiledHeader>Use</PrecompiledHeader>
