    <!-- shortcut: Rider's C++ MSBuild build invokes this project with /t:DiscordBearTests (project name as target); alias it to Build, same as DiscordBear.vcxproj. -->
    <Target Name="DiscordBearTests" DependsOnTargets="Build"/>
    <!-- DiscordBear.dll ships next to the plugin, so the staged one (see DiscordBearDir in PropertySheet2.props) goes next to
         the build output before the post-build step deploys that folder to OBS. CI's packaging picks it up from there too. -->
    <Target Name="BearCopyDiscordBear" BeforeTargets="PostBuildEvent">
        <Copy SourceFiles="$(DiscordBearDir)$(Configuration)\DiscordBear.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
    </Target>
    <!-- Stopping the debugger kills OBS, which leaves its run_* marker files in %APPDATA%\obs-studio\.sentinel; the next launch then
         opens a "Crash or unclean shutdown detected" safe mode prompt (OBS has no switch to skip it). Clearing the markers on a deploying
         Debug build keeps that prompt from sitting between you and the debugger. -->
    <Target Name="BearClearObsCrashMarkers" AfterTargets="Build" Condition="'$(DeployToOBS)'=='true' and '$(Configuration)'=='Debug' and Exists('$(APPDATA)\obs-studio\.sentinel')">
        <ItemGroup>
            <_BearObsCrashMarker Include="$(APPDATA)\obs-studio\.sentinel\run_*"/>
        </ItemGroup>
        <Delete Files="@(_BearObsCrashMarker)" ContinueOnError="true"/>
    </Target>
