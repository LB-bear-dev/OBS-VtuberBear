        <LocalDebuggerCommand>$([MSBuild]::EnsureTrailingSlash('$(OBSEXE)'))obs64.exe</LocalDebuggerCommand>
        <LocalDebuggerWorkingDirectory>$([MSBuild]::EnsureTrailingSlash('$(OBSEXE)'))</LocalDebuggerWorkingDirectory>
        <LocalDebuggerCommandArguments>--disable-updater --disable-missing-files-check</LocalDebuggerCommandArguments>
