    <!-- Run/debug launches OBS (OBSEXE is its bin\64bit folder, see PropertySheet2.props) with the plugin deployed by the post-build copy.
         Its updater and missing-files dialogs are switched off so nothing modal waits behind the debugger. -->
    <PropertyGroup>
