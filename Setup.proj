<Project DefaultTargets="Setup">
    <Import Project="Directory.Build.props"/>
    <Import Project="BearApps.user.props" Condition="Exists('BearApps.user.props')"/>
    <Target Name="Setup">
        <Exec Command="git submodule update --init" WorkingDirectory="$(MSBuildThisFileDirectory)" IgnoreStandardErrorWarningFormat="true"/>
        <Error Condition="'$(OBSPATH)'=='' or !Exists('$(OBSPATH)\libobs')" Text="OBS build not found at OBSPATH='$(OBSPATH)'. Set OBSPATH in BearApps.user.props to your OBS Studio $(ObsVersion) build_x64 folder (see README)."/>
        <Message Importance="high" Text="OBS: using $(OBSPATH)"/>
        <Message Importance="high" Text="Done. Open OBS-VtuberBear.sln, or build with: msbuild OBS-VtuberBear.sln /p:Configuration=Release /p:Platform=x64"/>
    </Target>
</Project>
