+				unsigned int count = static_cast<unsigned int>(byte + 1);
+
+				if (count > srcSize - bytesRead || count > size - offset)
+				{
+					PSD_ERROR("DecompressRle", "Malformed RLE data encountered");
+					return;
+				}
+
 				memcpy(dest + offset, src, count);
 
